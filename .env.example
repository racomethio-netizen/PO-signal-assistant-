# ==========================================================================
# Pocket Option Signal Assistant — environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
#
# This application never stores Pocket Option passwords, 2FA codes,
# session cookies, or auth tokens. There is nothing of that kind to
# configure here, and no setting below enables automated trade placement.
# ==========================================================================

# --- Anthropic (Claude) integration -----------------------------------
# Used ONLY to generate human-readable explanations of signals that are
# already computed deterministically. If unset, the app keeps working and
# shows "AI EXPLANATION UNAVAILABLE" instead of an LLM summary.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_TIMEOUT_SECONDS=20

# --- Telegram alerts (optional) ----------------------------------------
# Read-only notifications. Sending a Telegram message never places,
# modifies, or closes a trade.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Minimum seconds between Telegram alerts, to avoid spamming the chat.
TELEGRAM_MIN_INTERVAL_SECONDS=60

# --- API server ----------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated list of allowed CORS origins for the dashboard.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- Application mode ------------------------------------------------------
# PAPER is the only mode this application supports. It exists as an explicit
# switch so that any future adapter is forced to check it; there is no LIVE
# mode and no code path that sends orders to Pocket Option.
APP_MODE=PAPER

# --- Risk defaults (can also be changed at runtime via the API/dashboard) --
PAPER_STARTING_BALANCE=1000
RISK_MAX_STAKE_PCT=0.01
RISK_MAX_DAILY_LOSS_PCT=0.03
RISK_MAX_CONSECUTIVE_LOSSES=3
RISK_COOLDOWN_TRADES=5
PAPER_MAX_TRADES_PER_DAY=20

# --- Signal engine defaults --------------------------------------------
SIGNAL_MIN_SCORE_THRESHOLD=35
